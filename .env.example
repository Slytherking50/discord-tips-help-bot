DISCORD_TOKEN=tu_token_aca

# Opcional: si lo dejas vacio, el bot mide actividad en todos los canales de texto de cada server
# Lista de IDs de canal separados por coma, para limitar donde puede mandar tips
TIPS_CHANNEL_WHITELIST=

# Silencia los mensajes promocionales que imprime una dependencia interna de "natural"
DOTENV_CONFIG_QUIET=true

# --- Dashboard web ---

# Developer Portal -> tu app -> General Information -> Application ID
DISCORD_CLIENT_ID=tu_client_id_aca

# Developer Portal -> tu app -> OAuth2 -> Client Secret (Reset Secret si no lo tenes)
DISCORD_CLIENT_SECRET=tu_client_secret_aca

# URL publica donde va a vivir el dashboard (la de Render), sin barra al final
DASHBOARD_URL=https://tu-servicio.onrender.com

# String random para firmar las cookies de sesion. Cualquier texto largo y unico sirve.
SESSION_SECRET=cambia_esto_por_algo_random_y_largo

# --- Base de datos (MongoDB Atlas) ---
MONGODB_URI=tu_connection_string_de_mongodb_atlas_aca
MONGODB_DB_NAME=discordTipsBot

# --- IA gratis (Groq) ---
# Opcional. Sin esto, las opciones de IA del dashboard quedan sin efecto.
# Conseguila gratis en https://console.groq.com/keys (no pide tarjeta)
GROQ_API_KEY=
# Opcionales: fuerzan el PRIMER modelo que se prueba (si no responde, sigue con la lista
# de respaldo). Sirve cuando Groq retira un modelo: ver los de tu cuenta con
# https://api.groq.com/openai/v1/models (con tu clave). Vacio = los de siempre.
# GROQ_SMART_MODEL  -> charla y ayuda (por defecto openai/gpt-oss-120b)
# GROQ_VISION_MODEL -> ver imagenes (por defecto qwen/qwen3.8-27b)
GROQ_SMART_MODEL=
GROQ_VISION_MODEL=

# --- Estado del bot (opcional) ---
# El estado rotativo del perfil del bot viene activado. BOT_STATUS=off lo apaga;
# BOT_STATUS_SECONDS cambia cada cuanto rota (por defecto 30, minimo 15).
BOT_STATUS=
BOT_STATUS_SECONDS=

# --- Alertas de Twitch (opcional) ---
# Sin esto las alertas de YouTube funcionan igual; solo las de Twitch quedan
# deshabilitadas. App gratis en https://dev.twitch.tv/console/apps (tipo
# "Confidential", cualquier URL de redireccion sirve: no se usa login)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Tu ID de usuario de Discord (Modo de desarrollador -> clic derecho en tu
# perfil -> Copiar ID de usuario). Te reconoce como creador del bot: puede
# pedirle acciones de moderacion por chat en cualquier server y la IA sabe
# que fuiste vos quien lo programo. Opcional, sin esto nadie tiene este acceso.
CREATOR_USER_ID=
